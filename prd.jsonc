{
  "project": {
    "name": "ignore-launcher-input-during-external-programs",
    "description": "Keep launcher and browser state stable while RetroArch or another external program owns the panel, while preserving explicit global controls."
  },
  "verification": {
    "commands": [
      {
        "name": "build",
        "command": "mix compile --warnings-as-errors",
        "description": "Compile the host application and fail on warnings"
      },
      {
        "name": "launcher-tests",
        "command": "mix test test/launcher_test.exs",
        "description": "Run focused launcher input, process lifecycle, and browser tests"
      },
      {
        "name": "test",
        "command": "mix test",
        "description": "Run the complete host test suite"
      },
      {
        "name": "format",
        "command": "mix format --check-formatted",
        "description": "Verify Elixir source and test formatting"
      }
    ],
    "runAfterEachFeature": true
  },
  "features": [
    {
      "id": "suppress-external-program-navigation",
      "category": "bugfix",
      "description": "Route input received while an external port is active through a dedicated ownership boundary that tracks key edges but prevents ordinary navigation and action events from mutating launcher or browser state.",
      "steps": [
        "Add an external-program handle_input clause before normal launcher dispatch while preserving sleeping and BEAM-app clause priority.",
        "Fold complete reports through explicit press and release bookkeeping, allowing only the existing sleep trigger and Menu handling and ignoring autorepeat and ordinary bindings.",
        "Add real-port regression tests asserting the complete browser, scene-related state, obituary, and held-key cleanup remain correct across representative D-pad, face-button, and shoulder reports.",
        "Add a mixed ordinary-input and Menu report test proving events from a report selected under port ownership cannot fall through after the process stops."
      ],
      "status": "pending"
    },
    {
      "id": "preserve-running-program-global-controls",
      "category": "test",
      "description": "Prove that Menu, Select+Menu, Power sleep, wake consumption, and failed-stop ownership continue to behave correctly while an external program runs.",
      "steps": [
        "Test that Menu stops a real long-running child and returns the launcher home without dispatching unrelated input.",
        "Test Select+Menu with the injected poweroff callback so held-key chord behavior remains active without powering off the host.",
        "Test Power sleep against a temporary backlight file and verify the next press wakes only, leaves the browser unchanged, and does not stop the program.",
        "Extend the unkillable-process scenario to verify ordinary input remains suppressed while the failed stop leaves the port active and panel held."
      ],
      "status": "pending"
    },
    {
      "id": "document-external-program-input-ownership",
      "category": "docs",
      "description": "Update launcher documentation and comments to describe stable hidden state, explicit global exceptions, and independent repaint safety while an external program owns the panel.",
      "steps": [
        "Document that launcher evdev reports still arrive during external programs but ordinary navigation and action input is ignored.",
        "Enumerate Menu, Select+Menu, Power and lid sleep, and wake consumption as the explicit global behavior.",
        "Correct stale comments that claim browser, scene, cursor, or obituary state can move during a game.",
        "Retain and explain browse and set_root repaint gates as framebuffer safety independent of input suppression."
      ],
      "status": "pending"
    }
  ],
  "completion": {
    "allFeaturesComplete": false,
    "allVerificationsPassing": false,
    "marker": "<promise>COMPLETE</promise>"
  }
}
