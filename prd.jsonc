{
  "project": {
    "name": "user-data-backup",
    "description": "Create a checksum-verified backup of approved user settings, saves, and Pickle data from the internal card on the second SD card."
  },
  "verification": {
    "commands": [
      {
        "name": "build",
        "command": "mix compile --warnings-as-errors",
        "description": "Compile the host project and reject warnings"
      },
      {
        "name": "test",
        "command": "mix test",
        "description": "Run the complete host test suite"
      },
      {
        "name": "format",
        "command": "mix format --check-formatted",
        "description": "Check Elixir formatting"
      }
    ],
    "runAfterEachFeature": true
  },
  "features": [
    {
      "id": "add-backup-catalog-and-preflight",
      "category": "functional",
      "description": "Add the fixed backup source catalog, private second-card layout, safe deterministic traversal, exclusions, totals, and free-space preflight.",
      "steps": [
        "Create MayonnaiOS.Backup and configure approved target and isolated host source/destination roots.",
        "Traverse regular files and empty directories deterministically while excluding generated RetroArch paths and rejecting unsafe entries or symlinks.",
        "Check destination availability, writability, and free space with a five-percent margin and manifest allowance.",
        "Add host tests for catalog scope, traversal, exclusions, unsafe entries, totals, and preflight failures."
      ],
      "status": "pending"
    },
    {
      "id": "coordinate-games-card-lease",
      "category": "functional",
      "description": "Prevent unmounting or concurrent backup ownership while a backup uses the removable games card.",
      "steps": [
        "Add monitored acquire and release APIs to MayonnaiOS.GamesCard with idempotence for one owner.",
        "Return busy for competing owners and unmount requests while the lease is active.",
        "Automatically release ownership when the monitored process exits.",
        "Test acquisition, competition, explicit release, owner death, and unchanged unleased behavior."
      ],
      "status": "pending"
    },
    {
      "id": "stream-and-verify-backup-files",
      "category": "functional",
      "description": "Copy approved files with bounded memory, durable staging writes, source-mutation detection, and destination SHA-256 verification.",
      "steps": [
        "Stream files in fixed-size chunks to sibling part files while hashing source bytes.",
        "Require source type, size, and mtime to match preflight immediately before and after each copy.",
        "Sync each open destination handle, rename the part file, and re-read the staged file to verify size and SHA-256.",
        "Emit throttled progress and stop with cleanup on cancellation or any I/O, sync, rename, mutation, or hash error.",
        "Test multi-chunk files, empty directories, mutation, cancellation, injected failures, bounded operation, and durability ordering."
      ],
      "status": "pending"
    },
    {
      "id": "write-portable-backup-metadata",
      "category": "functional",
      "description": "Produce deterministic desktop-compatible checksums and a versioned completion manifest after all staged files verify.",
      "steps": [
        "Generate deterministic SHA256SUMS entries for files below the backup data directory.",
        "Generate manifest.json with format version, optional synchronized UTC, firmware and device metadata, source status, exclusions, sizes, and hashes.",
        "Sync and publish the checksum list before syncing and publishing the completion manifest last.",
        "Validate manifests, relative paths, records, source files, sizes, and checksums without trusting backup-provided absolute paths.",
        "Test deterministic output, unknown clock state, malformed metadata, path escapes, corruption, and completion-marker ordering."
      ],
      "status": "pending"
    },
    {
      "id": "recover-and-publish-backup",
      "category": "functional",
      "description": "Preserve the previous known-good backup while staging, publishing, and recovering from interruption at any rotation point.",
      "steps": [
        "Reconcile current, staging, and previous directories before each run, preferring validated data and never deleting the sole valid copy.",
        "Rotate a validated staged backup through fixed private names on the same filesystem and validate the published current backup.",
        "Restore the previous backup when publication fails and clean only known private staging artifacts.",
        "Wrap runs in games-card lease acquisition and guaranteed release with structured logging and success/error results.",
        "Add table-driven recovery and injected publication-failure tests for all meaningful directory states."
      ],
      "status": "pending"
    },
    {
      "id": "add-backup-app-state-machine",
      "category": "functional",
      "description": "Run backup work asynchronously behind the established launcher app protocol with progress, cancellation, and retry states.",
      "steps": [
        "Create MayonnaiOS.Backup.App with start, stop, input, scene, watch, snapshot, sessions, and temporary child APIs.",
        "Represent idle, preflight, copy, verification, done, cancelled, and error states in stable snapshots.",
        "Run one linked worker so the app stays responsive and ensure app termination kills work, cleans staging, and releases the card lease.",
        "Notify monitored watchers with coalesced progress and expose structured failures for rendering.",
        "Test transitions, retries, watcher cleanup, duplicate starts, progress, worker crashes, cancellation, and resource release."
      ],
      "status": "pending"
    },
    {
      "id": "render-backup-scene",
      "category": "functional",
      "description": "Add a 640-by-480 Scenic backup screen with clear scope, progress, cancellation warnings, success details, and actionable errors.",
      "steps": [
        "Create MayonnaiOS.Scene.Backup using the shared status bar and stateless watched-snapshot pattern.",
        "Explain included and excluded data and the second-card destination on the idle screen.",
        "Render phase, logical source, file and byte totals, progress, and interruption warnings while active.",
        "Render verified completion, safe-unmount guidance, cancellation, and concise known and unknown errors.",
        "Add graph tests for every state, progress edge case, message mapping, stopped app, and status-bar bounds."
      ],
      "status": "pending"
    },
    {
      "id": "integrate-backup-into-launcher",
      "category": "functional",
      "description": "Register and supervise the backup app in target and host System menus with safe host scratch storage.",
      "steps": [
        "Add the backup app DynamicSupervisor sessions child to MayonnaiOS.Application on host and target.",
        "Add the Back up user data row to target and host program configuration under System.",
        "Create host scratch source and destination directories through host runtime without touching real user data.",
        "Update browser, host-runtime, and launcher tests for classification, launch, input, cancellation, and ordering."
      ],
      "status": "pending"
    },
    {
      "id": "document-backup-and-recovery",
      "category": "docs",
      "description": "Document the backup contract, exclusions, manual desktop recovery, durability limits, and required hardware validation scenarios.",
      "steps": [
        "Update the README and data-layout documentation with the backup location, ownership, retention, included data, and exclusions.",
        "Add a backup guide covering progress, cancellation, SHA256SUMS verification, safe unmount, and manual path-by-path recovery.",
        "State the honest FAT power-loss limits and out-of-scope restore, history, ROM, secret, pairing, and encryption behavior.",
        "Document an RG40XXV checklist for exFAT, vFAT, full/read-only/removed cards, cancellation, power loss, recovery, large files, names, throughput, and unmount."
      ],
      "status": "pending"
