{
  "project": {
    "name": "full-width-menu-labels",
    "description": "Fit launcher menu item labels to the full available column width using measured theme-font metrics"
  },
  "verification": {
    "commands": [
      {
        "name": "format",
        "command": "mix format --check-formatted",
        "description": "Check Elixir source formatting"
      },
      {
        "name": "build",
        "command": "mix compile",
        "description": "Compile the host project"
      },
      {
        "name": "test",
        "command": "mix test",
        "description": "Run the full host test suite"
      }
    ],
    "runAfterEachFeature": true
  },
  "features": [
    {
      "id": "fit-column-row-labels-by-pixel-width",
      "category": "functional",
      "description": "Replace fixed character-count truncation for selectable launcher rows with grapheme-safe pixel fitting that gives leaf rows all available width while reserving the chevron lane for expandable rows",
      "steps": [
        "Add scene-private label fitting that measures the current theme font with Theme.width/2 at the row's actual font size",
        "Return unchanged fitting text or the longest grapheme-safe prefix plus a Unicode ellipsis that stays inside the supplied pixel budget",
        "Derive leaf and expandable row budgets from the existing slot inset, right padding, and chevron geometry",
        "Use the measured fitter for parent, focused, and action-sheet row labels without changing row layout or navigation",
        "Run formatter and launcher tests"
      ],
      "status": "pending"
    },
    {
      "id": "fit-preview-listing-labels-by-pixel-width",
      "category": "functional",
      "description": "Use the full available width for menu entry names shown in the right-hand listing preview",
      "steps": [
        "Apply the shared scene-private fitter to preview listing entry names at their existing 16 px font size",
        "Use the pixel budget from the preview's current text origin to the slot's right padding without reserving an unused chevron lane",
        "Leave preview captions, empty-state notes, metadata, and non-menu truncation unchanged",
        "Run formatter and launcher tests"
      ],
      "status": "pending"
    },
    {
      "id": "test-menu-label-width-boundaries",
      "category": "test",
      "description": "Cover full-width labels, measured truncation, chevron reservation, preview fitting, and Unicode grapheme safety in the home-scene graph",
      "steps": [
        "Add a graph regression showing a label longer than the former 15-character cap remains intact when its measured glyphs fit",
        "Assert a wide overflowing label becomes the exact longest fitting prefix plus ellipsis and remains within its pixel budget",
        "Test that leaf rows can use the chevron lane while expandable rows reserve it",
        "Test right-hand preview fitting at its 16 px font size and 188 px budget",
        "Add a composed-Unicode truncation case that proves grapheme clusters are not split",
        "Run mix format --check-formatted and the full mix test suite"
      ],
      "status": "pending"
    }
  ],
  "completion": {
    "allFeaturesComplete": false,
    "allVerificationsPassing": false,
    "marker": "<promise>COMPLETE</promise>"
  }
}
