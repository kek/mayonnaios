{
  "project": {
    "name": "recursive-directory-operations",
    "description": "Copy directories and move them across filesystems from the Files browser without freezing the launcher, while preserving no-overwrite and pulled-power safety."
  },
  "verification": {
    "commands": [
      {
        "name": "format",
        "command": "mix format --check-formatted",
        "description": "Check Elixir formatting"
      },
      {
        "name": "build",
        "command": "mix compile --warnings-as-errors",
        "description": "Compile the host application with warnings treated as errors"
      },
      {
        "name": "test",
        "command": "mix test",
        "description": "Run the complete host test suite"
      }
    ],
    "runAfterEachFeature": true
  },
  "features": [
    {
      "id": "preflight-recursive-trees",
      "category": "functional",
      "description": "Scan a source directory into a safe manifest before writing, rejecting symlinks, special entries, changed policy names, unsafe destinations, and overlapping source/destination trees.",
      "steps": [
        "Add recursive manifest and summary types plus a location-based preflight API in MayonnaiOS.Files.",
        "Walk with lstat, validate every relative component, collect directory and regular-file identity fields, and report scan progress and cancellation.",
        "Reject symlink destination ancestors and source/destination containment across overlapping configured roots.",
        "Add Files tests for valid nested trees, empty entries, unsupported entries, path safety, totals, and cancellation before writes."
      ],
      "status": "pending"
    },
    {
      "id": "enforce-recursive-space-policy",
      "category": "functional",
      "description": "Refuse recursive work unless destination free space is known and covers source bytes plus conservative metadata headroom.",
      "steps": [
        "Implement the 16 MiB-or-1-percent headroom calculation for recursive operations.",
        "Require a successful destination space reading before staging and recheck remaining room before each regular file.",
        "Return distinct unknown-space and insufficient-space reasons without changing regular-file copy behavior.",
        "Test policy boundaries, unknown space, initial ENOSPC, and a free-space drop during copying."
      ],
      "status": "pending"
    },
    {
      "id": "copy-directory-through-staging",
      "category": "functional",
      "description": "Copy a manifest into a marked sibling staging directory, fsync each file, and expose the final directory only after complete verification and promotion.",
      "steps": [
        "Create a no-overwrite name.part staging root with a private MayonnaiOS ownership marker.",
        "Revalidate each manifest entry, create directories, and stream regular files through per-file .part files with fsync before rename.",
        "Emit byte, entry, and relative-path progress while stopping on the first error.",
        "Verify the source manifest again, rename the complete staging root to the final name, and remove the private marker.",
        "Test byte fidelity, empty directories, fsync ordering, source mutation, collisions, progress, promotion, and failure cleanup."
      ],
      "status": "pending"
    },
    {
      "id": "cancel-and-discard-staging",
      "category": "functional",
      "description": "Cancel recursive work at bounded checkpoints and safely discard only incomplete trees proven to be owned by MayonnaiOS.",
      "steps": [
        "Check cooperative cancellation between scanned entries, between 64 KiB chunks, before promotion, and before destructive cleanup.",
        "Remove current file parts and marked staging trees after cancellation, preserving and reporting a stage if cleanup fails.",
        "Add incomplete-stage detection and discard APIs that require the exact private marker.",
        "Test cancellation during scan and file transfer, cleanup failure, and refusal to recursively remove unmarked user directories."
      ],
      "status": "pending"
    },
    {
      "id": "move-directory-across-filesystems",
      "category": "functional",
      "description": "Fall back from an EXDEV directory rename to staged copy followed by manifest-safe source deletion, retaining both trees on cleanup failure.",
      "steps": [
        "Preserve the synchronous same-filesystem directory rename path.",
        "Dispatch an EXDEV directory move through recursive preflight and staged copy.",
        "Verify source identity before deleting manifest-matching files and directories bottom-up.",
        "Retain the promoted destination and source when source cleanup fails and return an explicit partial-move result.",
        "Test promotion-before-deletion ordering, success, cancellation, changed sources, unexpected children, and cleanup failure."
      ],
      "status": "pending"
    },
    {
      "id": "supervise-files-worker",
      "category": "functional",
      "description": "Run recursive copy, move, and discard operations in a temporary supervised worker that reports throttled, job-tagged progress.",
      "steps": [
        "Add MayonnaiOS.Files.Worker and its host-and-target DynamicSupervisor child specification.",
        "Start temporary jobs with an owner pid, worker pid, and opaque job reference and never restart failed filesystem work.",
        "Monitor the owner and cooperatively cancel and clean up if it exits.",
        "Throttle ordinary progress to four updates per second while always sending phase and terminal transitions.",
        "Add worker tests for supervision, owner loss, message tags, throttling, cancellation, crashes, and terminal results."
      ],
      "status": "pending"
    },
    {
      "id": "model-browser-file-jobs",
      "category": "functional",
      "description": "Keep Browser pure while representing recursive operation commands, progress, gating, clipboard outcomes, and marked-stage discard confirmation.",
      "steps": [
        "Extend Browser state with serializable operation presentation and pending command data.",
        "Offer Copy for real directories and make directory Paste emit a command instead of doing recursive I/O in Browser.",
        "Suppress mutating actions and second jobs while active but retain read-only navigation and inspection.",
        "Offer confirmed discard only for Files-validated marked .part directories.",
        "Test action availability, commands, single-job gating, progress transitions, clipboard outcomes, and stale-stage safety."
      ],
      "status": "pending"
    },
    {
      "id": "orchestrate-files-jobs-in-launcher",
      "category": "functional",
      "description": "Have Launcher start and monitor one recursive worker, remain responsive to browsing and cancellation, and block unsafe actions until terminal handling.",
      "steps": [
        "Store the active worker pid, job ref, monitor, and affected locations separately from Browser presentation state.",
        "Drain Browser commands, retain synchronous regular-file and same-filesystem rename behavior, and delegate recursive work only.",
        "Handle only matching progress, result, and DOWN messages and refresh an affected focused column at completion.",
        "Reserve B for cancellation, allow browsing and Menu-to-root, and block program launch, sleep, poweroff, mutations, and idle sleep while active.",
        "Test responsiveness, control gating, stale messages, crashes, one-job enforcement, refresh, and idle-timer behavior."
      ],
      "status": "pending"
    },
    {
      "id": "render-directory-operation-progress",
      "category": "functional",
      "description": "Show honest scanning, copying, moving, cleanup, cancellation, completion, and failure state on the 640x480 home scene.",
      "steps": [
        "Render scanning with discovered entries and bytes without a false percentage.",
        "Render transfer totals and a truncated current relative path, plus explicit cleanup and cancelling phases.",
        "Give active operation state footer precedence and label B cancellation until requested.",
        "Add user-facing reason strings for recursive safety and partial-move failures.",
        "Add headless graph-text tests for each phase, bounded text, hint precedence, and errors."
      ],
      "status": "pending"
    },
    {
      "id": "document-recursive-file-operations",
      "category": "docs",
      "description": "Document recursive copy and cross-filesystem move behavior, staging recovery, controls, durability limits, and the continued refusal of general recursive delete.",
      "steps": [
        "Update README file-management documentation with preflight, progress, cancellation, staging, and cross-card move behavior.",
        "Update Files, Browser, and Launcher moduledocs to remove stale claims and describe ownership boundaries and controls.",
        "Document that symlinks are refused, metadata is not preserved, directory entries cannot be fsynced through OTP, and resume is unsupported.",
        "Run formatting, compilation with warnings as errors, and the complete host test suite."
      ],
      "status": "pending"
    },
    {
      "id": "validate-recursive-operations-on-device",
      "category": "test",
      "description": "Validate recursive operations and interruption behavior on the handheld's real F2FS and exFAT filesystems before claiming hardware completion.",
      "steps": [
        "Copy and move a hashed nested ROM fixture in both directions between internal F2FS and games-card exFAT.",
        "Verify empty directories, progress cadence, cancellation responsiveness, clipboard semantics, and instant same-filesystem rename.",
        "Test card removal and insufficient space without writing into the unmounted games-card mountpoint.",
        "Pull power during transfer and before promotion, reboot, verify recognizable marked staging, and discard it through the device UI.",
        "Record firmware revision, filesystem details, hashes, and outcomes in the implementation pull request."
      ],
      "status": "pending"
    }
  ],
  "completion": {
    "allFeaturesComplete": false,
    "allVerificationsPassing": false,
    "marker": "<promise>COMPLETE</promise>"
  }
}
